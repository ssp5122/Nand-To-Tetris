// Hack memory map:
// RAM:      0..16383
// Screen:   16384..24575
// Keyboard: 24576 (read-only)
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Address bit 14 selects RAM versus the upper memory-mapped area.
    DMux(in=load, sel=address[14], a=loadRAM, b=loadUpper);

    // Within the upper area, address bit 13 selects Screen (0) or Keyboard (1).
    Not(in=address[13], out=notKeyboardSelect);
    And(a=loadUpper, b=notKeyboardSelect, out=loadScreen);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    Mux16(a=screenOut, b=keyboardOut, sel=address[13], out=upperOut);
    Mux16(a=ramOut, b=upperOut, sel=address[14], out=out);
}
